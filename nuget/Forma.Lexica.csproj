<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <StaticWebAssetBasePath>_content/lexica</StaticWebAssetBasePath>
    </PropertyGroup>

    <!-- The package a host references. It ships Lexica as the one bundled file wwwroot/lexica.js, which scripts/bundle.mjs makes from src/. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>formaui-net.Lexica</PackageId>
        <VersionPrefix>1.0.0</VersionPrefix>
        <Authors>Eyal Alon</Authors>
        <Description>Lexica is a general-purpose, embeddable language that lets applications define their own domain as an integral part of the language. Its expressions and data are immutable, and evaluation is read-only; changes to the domain are explicit requests carried out by the host.</Description>
        <PackageTags>lexica;expression;language;javascript;dotnet;forma;formaui</PackageTags>
        <PackageProjectUrl>https://github.com/FormaUI/Lexica</PackageProjectUrl>
        <RepositoryUrl>https://github.com/FormaUI/Lexica</RepositoryUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <!-- The version: an alpha of 1.0.0 numbered by the commits of the history it is built from, so a clone counts only as much history as it holds. -->
    <Target Name="NumberAlphaByCommits" BeforeTargets="GetAssemblyVersion;GenerateNuspec">
        <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
            <Output TaskParameter="ConsoleOutput" PropertyName="CommitCount" />
        </Exec>
        <PropertyGroup>
            <Version>$(VersionPrefix)-alpha.$(CommitCount)</Version>
            <PackageVersion>$(Version)</PackageVersion>
        </PropertyGroup>
    </Target>

    <!-- A package without the bundle would ship nothing, and one whose bundle answers another version would misreport itself, so packing stops until publish.ps1 has made the bundle of this version. -->
    <Target Name="EnsureBundle" BeforeTargets="Pack" DependsOnTargets="NumberAlphaByCommits">
        <Error Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\lexica.js')" Text="wwwroot/lexica.js is missing; run ./publish.ps1, which bundles Lexica and packs it." />
        <Error Condition="!$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\wwwroot\lexica.js').Contains('&quot;$(Version)&quot;'))" Text="wwwroot/lexica.js answers another version than $(Version); run ./publish.ps1, which bundles Lexica of this version and packs it." />
    </Target>

</Project>
