<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <StaticWebAssetBasePath>_content/lexica</StaticWebAssetBasePath>
    </PropertyGroup>

    <!-- The package a host references. It ships Lexica as the one bundled file wwwroot/lexica.js, which scripts/bundle.mjs makes from src/. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>formaui-net.Lexica</PackageId>
        <Authors>Eyal Alon</Authors>
        <Description>Lexica is a general-purpose, embeddable language that evaluates scripts against what a host binds, through a vocabulary its modules declare for the domain, and produces immutable data.</Description>
        <PackageTags>lexica;expression;language;javascript;dotnet;forma;formaui</PackageTags>
        <PackageProjectUrl>https://github.com/FormaUI/Lexica</PackageProjectUrl>
        <RepositoryUrl>https://github.com/FormaUI/Lexica</RepositoryUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <!-- The version: the implementation's release version src/language/Versions.mjs declares, so the package, the bundle and the sources report one version. -->
    <PropertyGroup>
        <VersionsSource>$(MSBuildProjectDirectory)\..\src\language\Versions.mjs</VersionsSource>
        <Version>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(VersionsSource)')), '(?s)^.*implementation = \x27([^\x27]+)\x27.*$', '$1'))</Version>
        <PackageVersion>$(Version)</PackageVersion>
    </PropertyGroup>

    <!-- A package without the bundle would ship nothing, and one whose bundle answers another version would misreport itself, so packing stops until publish.ps1 has made the bundle of this version. -->
    <Target Name="EnsureBundle" BeforeTargets="Pack">
        <Error Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\lexica.js')" Text="wwwroot/lexica.js is missing; run ./publish.ps1, which bundles Lexica and packs it." />
        <Error Condition="!$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\wwwroot\lexica.js').Contains('&quot;$(Version)&quot;'))" Text="wwwroot/lexica.js answers another version than $(Version); run ./publish.ps1, which bundles Lexica of this version and packs it." />
    </Target>

</Project>
